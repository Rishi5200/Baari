# Local demo of the production stack: docker compose -f ops/docker-compose.prod.yml --env-file ops/demo.env up -d --build
# PUBLIC values, for a laptop only. The dev profile seeds the demo clinic with the logins from
# application-dev.yml and uses its public encryption keys. Never use this file on a reachable server.
BAARI_PROFILES=prod,dev
BAARI_SITE_ADDRESS=http://localhost
BAARI_DB_PASSWORD=demo-only-password
BAARI_BACKUP_DIR=./backups

# Simulated reception and doctor on the dr-sharma queue, 3x faster than real so the queue visibly moves.
COMPOSE_PROFILES=demo
BAARI_DRIVE_PASSWORD=dev-reception-pass
BAARI_DRIVE_SPEED=3
