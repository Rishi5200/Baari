# Copy to ops/.env on the server (git ignores .env) and fill in every value.
#   docker compose -f ops/docker-compose.prod.yml --env-file ops/.env up -d --build

# The public domain; its DNS A record must point at this machine (Caddy then gets the certificate).
BAARI_SITE_ADDRESS=baari.example.com

# openssl rand -base64 24
BAARI_DB_PASSWORD=

# AES-256 key for phone numbers at rest: openssl rand -base64 32
# Losing it makes stored phone numbers unreadable; changing it needs a re-encryption step.
BAARI_DATA_KEY=
# HMAC pepper for phone lookups: openssl rand -base64 32
BAARI_PHONE_PEPPER=

# Where nightly dumps land on the host; copy this directory off the machine.
BAARI_BACKUP_DIR=/var/backups/baari

# Optional, for a public demo only: simulated activity on one queue (see the driver service).
# Needs a clinic, a queue and a RECEPTIONIST login created through the admin pages first.
# COMPOSE_PROFILES=demo
# BAARI_DRIVE_CLINIC=sharma-clinic
# BAARI_DRIVE_QUEUE=dr-sharma
# BAARI_DRIVE_USER=reception
# BAARI_DRIVE_PASSWORD=
# BAARI_DRIVE_SPEED=1
